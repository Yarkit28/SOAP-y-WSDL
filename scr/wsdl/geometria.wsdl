<?xml version="1.0" encoding="UTF-8"?>
<definitions
    xmlns="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:tns="http://example.com/geometria"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    name="GeometriaService"
    targetNamespace="http://example.com/geometria">

  <!-- ═══════════════════════════════════════════════════════════
       1. TYPES: Definición de tipos y elementos XML
       ═══════════════════════════════════════════════════════════ -->
  <types>
    <xsd:schema targetNamespace="http://example.com/geometria"
                elementFormDefault="qualified">

      <!-- ─── Operación: AreaRectangulo ─── -->
      <xsd:element name="AreaRectanguloRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="base" type="xsd:double"/>
            <xsd:element name="altura" type="xsd:double"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="AreaRectanguloResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="area" type="xsd:double"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <!-- ─── Operación: PerimetroRectangulo ─── -->
      <xsd:element name="PerimetroRectanguloRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="base" type="xsd:double"/>
            <xsd:element name="altura" type="xsd:double"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="PerimetroRectanguloResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="perimetro" type="xsd:double"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

    </xsd:schema>
  </types>

  <!-- ═══════════════════════════════════════════════════════════
       2. MESSAGES: Mensajes de entrada y salida por operación
       ═══════════════════════════════════════════════════════════ -->
  <message name="AreaRectanguloInput">
    <part name="parameters" element="tns:AreaRectanguloRequest"/>
  </message>
  <message name="AreaRectanguloOutput">
    <part name="parameters" element="tns:AreaRectanguloResponse"/>
  </message>

  <message name="PerimetroRectanguloInput">
    <part name="parameters" element="tns:PerimetroRectanguloRequest"/>
  </message>
  <message name="PerimetroRectanguloOutput">
    <part name="parameters" element="tns:PerimetroRectanguloResponse"/>
  </message>

  <!-- ═══════════════════════════════════════════════════════════
       3. PORT TYPE: Operaciones ofrecidas por el servicio
       ═══════════════════════════════════════════════════════════ -->
  <portType name="GeometriaPortType">
    <operation name="AreaRectangulo">
      <input message="tns:AreaRectanguloInput"/>
      <output message="tns:AreaRectanguloOutput"/>
    </operation>
    <operation name="PerimetroRectangulo">
      <input message="tns:PerimetroRectanguloInput"/>
      <output message="tns:PerimetroRectanguloOutput"/>
    </operation>
  </portType>

  <!-- ═══════════════════════════════════════════════════════════
       4. BINDING: Vinculación con SOAP (document/literal)
       ═══════════════════════════════════════════════════════════ -->
  <binding name="GeometriaBinding" type="tns:GeometriaPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>

    <operation name="AreaRectangulo">
      <soap:operation soapAction="http://example.com/geometria/AreaRectangulo"/>
      <input>
        <soap:body use="literal"/>
      </input>
      <output>
        <soap:body use="literal"/>
      </output>
    </operation>

    <operation name="PerimetroRectangulo">
      <soap:operation soapAction="http://example.com/geometria/PerimetroRectangulo"/>
      <input>
        <soap:body use="literal"/>
      </input>
      <output>
        <soap:body use="literal"/>
      </output>
    </operation>
  </binding>

  <!-- ═══════════════════════════════════════════════════════════
       5. SERVICE: Dirección HTTP del endpoint
       ═══════════════════════════════════════════════════════════ -->
  <service name="GeometriaService">
    <port name="GeometriaPort" binding="tns:GeometriaBinding">
      <soap:address location="http://localhost:3000/soap/geometria"/>
    </port>
  </service>

</definitions>